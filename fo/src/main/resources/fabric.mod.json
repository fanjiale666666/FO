{
  "schemaVersion": 1,
  "id": "fo",
  "version": "${version}",
  "name": "FO",
  "description": "FO 生存辅助全自动插件：鞘翅全自动采集、自动种树、自动扔垃圾、自动使用物品。",
  "authors": [
    "jialebot6666"
  ],
  "contact": {
    "sources": "https://github.com/jialebot6666/fo"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.fo.addon.AddonTemplate"
    ]
  },
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
